{
  "pluginsConfig": {
    "@nx/js": {
      "analyzePackageJson": false
    }
  },
  "extends": "nx/presets/npm.json",
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "test:unit": {
      "cache": true
    },
    "test:integration": {
      "cache": true
    },
    "test:coverage": {
      "cache": true,
      "outputs": [
        "{projectRoot}/coverage"
      ]
    },
    "test:coverage-check": {
      "cache": true
    },
    "validate:api": {
      "cache": true
    },
    "validate:api:in": {
      "cache": true
    }
  },
  "useInferencePlugins": false,
  "defaultBase": "master",
  "analytics": false
}