{
  "test_cases": [
    {
      "id": 1,
      "name": "Trigger inbound party lookup metric",
      "requests": [
        {
          "id": 1,
          "description": "GET /parties/MSISDN/1234567890 - triggers partyLookupRequests counter",
          "apiVersion": {
            "minorVersion": 0,
            "majorVersion": 1,
            "type": "fspiop",
            "asynchronous": false,
            "specFile": "spec_files/api_definitions/fspiop_1.0/api_spec.yaml",
            "callbackMapFile": "spec_files/api_definitions/fspiop_1.0/callback_map.json",
            "responseMapFile": "spec_files/api_definitions/fspiop_1.0/response_map.json",
            "jsfRefFile": "spec_files/api_definitions/fspiop_1.0/mockRef.json"
          },
          "operationPath": "/parties/{Type}/{ID}",
          "path": "/parties/MSISDN/1234567890",
          "method": "get",
          "url": "http://sdk-scheme-adapter-api-svc:4000",
          "headers": {
            "Accept": "application/vnd.interoperability.parties+json;version=1",
            "Content-Type": "application/vnd.interoperability.parties+json;version=1.0",
            "Date": "{$function.generic.curDate}",
            "FSPIOP-Source": "testfsp",
            "FSPIOP-Destination": "mojaloop-sdk"
          },
          "tests": {
            "assertions": [
              {
                "id": 1,
                "description": "Response should be 202 Accepted",
                "exec": [
                  "expect(response.status).to.equal(202)"
                ]
              }
            ]
          }
        }
      ],
      "fileInfo": {
        "path": "sample-tests/inbound-metrics-trigger.json"
      }
    },
