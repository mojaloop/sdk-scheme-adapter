{
  "name": "@mojaloop/sdk-scheme-adapter",
  "version": "24.19.7",
  "description": "mojaloop sdk-scheme-adapter",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mojaloop/sdk-scheme-adapter",
  "bugs": {
    "url": "https://github.com/mojaloop/sdk-scheme-adapter/issues#readme"
  },
  "contributors": [
    "Kamuela Franco <kamuela.franco@modusbox.com>",
    "Steven Oderayi <steven.oderayi@modusbox.com>",
    "Valentin Genev <valentin.genev@modusbox.com>",
    "Shashikant Hirugade <shashikant.hirugade@modusbox.com>",
    "Paweł Marzec <pawel.marzec@modusbox.com>",
    "Kevin Leyow <kevin.leyow@modusbox.com",
    "Miguel de Barros <miguel.debarros@modusbox.com>",
    "Yevhen Kyriukha <yevhen.kyriukha@modusbox.com>",
    "Vijay Kumar Guthi <vijaya.guthi@modusbox.com>"
  ],
  "packageManager": "yarn@4.18.0",
  "engines": {
    "yarn": ">=4.0.0"
  },
  "workspaces": [
    "modules/*"
  ],
  "scripts": {
    "postinstall": "yarn husky install",
    "start": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter --parallel --interlaced --jobs unlimited run start",
    "start:api-svc": "yarn workspace @mojaloop/sdk-scheme-adapter-api-svc run start",
    "start:event-handler": "yarn workspace @mojaloop/sdk-scheme-adapter-outbound-domain-event-handler run start",
    "start:command-handler": "yarn workspace @mojaloop/sdk-scheme-adapter-outbound-command-event-handler run start",
    "build": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter --parallel --topological run build",
    "build:affected": "yarn workspaces foreach --since --exclude @mojaloop/sdk-scheme-adapter --parallel --topological run build",
    "build:no-cache": "yarn run build",
    "build:openapi": "yarn workspace @mojaloop/sdk-scheme-adapter-api-svc run build:openapi",
    "build:openapi:inbound": "yarn workspace @mojaloop/sdk-scheme-adapter-api-svc run build:openapi:inbound",
    "docker:build": "docker build --build-arg NODE_VERSION=\"$(cat .nvmrc)-alpine\" -t mojaloop/sdk-scheme-adapter:local -f ./Dockerfile .",
    "docker:up": "docker-compose up",
    "docker:stop": "docker-compose stop",
    "docker:rm": "docker-compose rm -f -v",
    "docker:down": "docker-compose down -v",
    "docker:clean": "docker-compose down --rmi local",
    "validate:api": "yarn workspace @mojaloop/sdk-scheme-adapter-api-svc run validate:api",
    "validate:api-sequence-diagram": "node ./scripts/validate-api-sequence-diagram.js",
    "watch": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter --parallel --interlaced --jobs unlimited run watch",
    "clean": "yarn run clean:dist && yarn run clean:npm",
    "clean:npm": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter --parallel run clean:npm",
    "clean:dist": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter --parallel run clean:dist",
    "lint": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter --parallel run lint",
    "lint:affected": "yarn workspaces foreach --since --exclude @mojaloop/sdk-scheme-adapter --parallel run lint",
    "lint:fix": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter --parallel run lint:fix",
    "lint:fix:affected": "yarn workspaces foreach --since --exclude @mojaloop/sdk-scheme-adapter --parallel run lint:fix",
    "test": "yarn run test:unit",
    "test:unit": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter --parallel run test:unit",
    "test:unit:no-cache": "yarn run test:unit",
    "test:unit:affected": "yarn workspaces foreach --since --exclude @mojaloop/sdk-scheme-adapter --parallel run test:unit",
    "test:xunit": "yarn install --immutable && yarn run build && yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter run test:xunit",
    "test:coverage": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter --parallel run test:coverage",
    "test:coverage:affected": "yarn workspaces foreach --since --exclude @mojaloop/sdk-scheme-adapter --parallel run test:coverage",
    "test:coverage-check": "yarn install --immutable && yarn run build && yarn run test:coverage-check-dev",
    "test:coverage-check-dev": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter run test:coverage-check",
    "test:coverage-check:affected": "yarn workspaces foreach --since --exclude @mojaloop/sdk-scheme-adapter --parallel run test:coverage-check",
    "test:functional": "./test/scripts/test-functional.sh",
    "test:integration": "./test/scripts/test-integration.sh",
    "test:integration:local": "yarn run test:integration -- --local",
    "test:integration-dev": "yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter --parallel run test:integration",
    "test:integration:affected": "yarn workspaces foreach --since --exclude @mojaloop/sdk-scheme-adapter --parallel run test:integration",
    "audit:check": "node ./scripts/audit-check.js",
    "audit:fix": "yarn-audit-fix",
    "license:check": "npx @mojaloop/license-scanner-tool .",
    "dep:check": "yarn ncu -e 2 && yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter run dep:check",
    "dep:update": "yarn ncu -u && yarn workspaces foreach --all --exclude @mojaloop/sdk-scheme-adapter run dep:update",
    "release": "yarn run release:modules -- --skip.tag --skip.commit && standard-version --commit-all --no-verify --releaseCommitMessageFormat 'chore(release): {{currentTag}} [skip ci]'",
    "release:modules": "yarn workspaces foreach --since --exclude @mojaloop/sdk-scheme-adapter --topological run release",
    "snapshot": "yarn run snapshot:modules -- --skip.tag --skip.commit && standard-version --commit-all --no-verify --skip.changelog --prerelease snapshot --releaseCommitMessageFormat 'chore(snapshot): {{currentTag}}'",
    "snapshot:modules": "yarn workspaces foreach --since --exclude @mojaloop/sdk-scheme-adapter --topological run snapshot",
    "wait-4-docker": "node ./scripts/_wait4_all.js"
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.13.2",
    "@types/node-cache": "4.2.5",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "audit-ci": "7.1.0",
    "eslint": "10.8.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "knex": "3.3.0",
    "nodemon": "3.1.14",
    "npm-check-updates": "16.7.10",
    "replace": "1.2.2",
    "standard-version": "9.5.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "yarn-audit-fix": "10.1.1"
  },
  "resolutions": {
    "cacache/glob": "10.5.0",
    "read-package-json/glob": "10.5.0",
    "validator": "13.15.35",
    "undici": "7.28.0",
    "qs": "6.15.3",
    "@mojaloop/api-snippets": "17.10.3",
    "axios": "1.19.0",
    "cacache/tar": "7.5.21",
    "cookie": "1.0.2",
    "express": "4.21.2",
    "form-data": "4.0.6",
    "formidable": "3.5.4",
    "koa": "3.2.1",
    "on-headers": "1.1.0",
    "path-to-regexp": "0.1.13",
    "serve-static": "1.16.2",
    "shins/ejs": "3.1.10",
    "shins/sanitize-html": "2.12.1",
    "shins/jsonpointer": "5.0.0",
    "shins/markdown-it": "14.2.0",
    "shins/yargs-parser": "21.1.1",
    "shins/postcss": "8.4.31",
    "shins/path-to-regexp": "0.1.13",
    "swagger-ui-express/express": "4.19.2",
    "shins/express": "4.19.2",
    "serve-static/send": "0.19.0",
    "tar": "7.5.21",
    "widdershins/yargs-parser": "21.1.1",
    "widdershins/markdown-it": "14.2.0",
    "widdershins/swagger2openapi": "7.0.8",
    "yargs-parser": "21.1.1",
    "fast-xml-parser": "5.10.1",
    "fast-uri": "3.1.4",
    "immutable": "5.1.8",
    "body-parser@1.20.3": "1.20.6",
    "brace-expansion@^1.1.7": "1.1.16",
    "brace-expansion@^2.0.1": "2.1.2",
    "brace-expansion@^2.0.2": "2.1.2",
    "brace-expansion@^5.0.5": "5.0.8",
    "brace-expansion@5.0.6": "5.0.8",
    "sigstore": "4.1.1",
    "postcss@^8.3.11": "8.5.18",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "serialize-error": "8.1.0",
    "protobufjs": "8.7.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "@mojaloop/platform-shared-lib-nodejs-kafka-client-lib/node-rdkafka": "3.6.1",
    "@redocly/openapi-core/js-yaml": "4.3.0",
    "replace/minimatch": "3.1.5",
    "@grpc/grpc-js": "1.14.4",
    "joi": "18.2.3",
    "convict": "6.2.5",
    "@mojaloop/central-services-shared": "18.37.0",
    "@mojaloop/inter-scheme-proxy-cache-lib": "2.10.0",
    "@mojaloop/ml-schema-transformer-lib": "2.10.0",
    "@types/node": "24.13.2"
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "replace '\\[mojaloop/#(\\d+)\\]\\(https://github.com/mojaloop/(.*)/issues/(\\d+)\\)' '[mojaloop/#$1](https://github.com/mojaloop/project/issues/$1)' CHANGELOG.md",
      "precommit": "git add **/*package.json"
    }
  }
}
