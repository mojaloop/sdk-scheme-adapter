{
  "name": "modules-api-svc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "modules/api-svc/src",
  "projectType": "application",
  "implicitDependencies": [
    "modules-private-shared-lib"
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "outputs": [
        "{projectRoot}/src/InboundServer/api.yaml"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "build:openapi": {
      "executor": "nx:run-script",
      "options": {
        "script": "build:openapi"
      }
    },
    "build:openapi:inbound": {
      "executor": "nx:run-script",
      "options": {
        "script": "build:openapi:inbound"
      }
    },
    "test:unit": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:unit"
      },
      "dependsOn": [
        "build"
      ],
      "cache": true
    },
    "test:xunit": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:xunit"
      },
      "dependsOn": [
        "build"
      ],
      "cache": true
    },
    "test:integration": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:integration"
      },
      "dependsOn": [
        "build"
      ],
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:coverage"
      },
      "dependsOn": [
        "build"
      ],
      "cache": true
    },
    "test:coverage-check": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:coverage-check"
      },
      "dependsOn": [
        "build"
      ],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-script",
      "options": {
        "script": "lint"
      },
      "cache": true
    },
    "lint:fix": {
      "executor": "nx:run-script",
      "options": {
        "script": "lint:fix"
      }
    },
    "clean:dist": {
      "executor": "nx:run-script",
      "options": {
        "script": "clean:dist"
      }
    },
    "validate:api": {
      "executor": "nx:run-script",
      "options": {
        "script": "validate:api"
      },
      "cache": true
    },
    "dep:check": {
      "executor": "nx:run-script",
      "options": {
        "script": "dep:check"
      }
    },
    "dep:update": {
      "executor": "nx:run-script",
      "options": {
        "script": "dep:update"
      }
    }
  }
}
