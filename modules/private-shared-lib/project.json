{
  "name": "modules-private-shared-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "modules/private-shared-lib/src",
  "projectType": "library",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "test:unit": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:unit"
      },
      "cache": true
    },
    "test:xunit": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:xunit"
      },
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:coverage"
      },
      "cache": true
    },
    "test:coverage-check": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:coverage-check"
      },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-script",
      "options": {
        "script": "lint"
      },
      "cache": true
    },
    "lint:fix": {
      "executor": "nx:run-script",
      "options": {
        "script": "lint:fix"
      }
    },
    "clean:dist": {
      "executor": "nx:run-script",
      "options": {
        "script": "clean:dist"
      }
    },
    "dep:check": {
      "executor": "nx:run-script",
      "options": {
        "script": "dep:check"
      }
    },
    "dep:update": {
      "executor": "nx:run-script",
      "options": {
        "script": "dep:update"
      }
    }
  }
}
